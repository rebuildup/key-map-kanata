;; ============================================================
;; Windows / JIS / Onishi + Space HUB v1
;; macOS 版 mac/kanata-us.kbd の Windows 移植
;;
;; 前提 (ChgKey / Scancode Map):
;;   物理キーボードの入力は ChgKey の Scancode Map (レジストリ) で
;;   大西配列に変換されてから kanata に届く。この環境では
;;   kanata の winIOv2 バックエンド (LL hook) も変換後の
;;   スキャンコードを受信することを実測で確認済み。
;;
;;   例: 物理 W キーは scan 0x26 (= 名前 l) として kanata に入る。
;;
;;   そのため defsrc は「物理配置」ではなく
;;   「ChgKey 適用後に kanata へ届くキー名」で定義する。
;;   (macOS 版の defsrc が物理配置なのは、kanata が生の入力を
;;   受けて大西変換を自分で持つため。Windows では ChgKey が
;;   下流で先に変換するので構造が逆になる。)
;;
;; kanata の出力 (SendInput) は Scancode Map を通過しないため、
;; deflayer で emit したキー名がそのままレイアウト変換されて
;; アプリへ届く。記号は JIS 配列で意図した文字を出す
;; スキャンコードへ変換して emit する (下表)。
;;
;; JIS 記号変換表 (US レイアウト意図の文字 → JIS で emit するキー):
;;   (   → S-8        )   → S-9
;;   [   → ]          ]   → \        ({  → S-]  }  → S-\)
;;   @   → [          ^   → =        (~  → S-=  `  → S-[)
;;   :   → '          ;   → ;        ("  → S-2  '  → S-7)
;;   |   → S-¥        _   → S-ro
;;   -   → -          =   → S--      (+  → S-;  *  → S-')
;;   <   → S-,        >   → S-.      (?  → S-/  &  → S-6)
;;   \   → ¥ (0x7D) ※ 名前 yen は 0x2B の別キーなので注意
;;
;; レイヤー構成:
;;   BASE
;;     F1    : Onishi <-> QWERTY 切替 (ChgKey で F1⇄Caps 済み)
;;     Caps  : 押している間 extra レイヤー (数字盤・矢印)
;;     Space : tap = Space / hold = HUB
;;   HUB (Space 押し中)
;;     H J K L        : 矢印
;;     Q              : Ctrl+F (検索)
;;     W E            : タブ切替 / Shift+Enter / Shift+Del
;;     Y U I O P      : 行頭/語/文頭/語/行末移動
;;     [ ]            : 前/次タブ (暫定)
;;     M              : マウスモードへ
;;     LShift tap     : 半角/全角 (英数)
;;     LShift hold    : 左シンボル + 右テンキー
;;     RShift tap     : かな (IME)
;;     RShift hold    : 右テンキー + 左シンボル
;;     逆側 Shift タップ : Automation レイヤー (one-shot)
;;   MOUSE (マウスモード)
;;     WASD / HJKL : ポインタ移動, Shift: 精密, Alt: 高速
;;     Space / Esc : 直前のベースへ戻る
;;
;; 緊急終了: LCtrl + Space + Esc 同時押し
;; ============================================================

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  movemouse-inherit-accel-state yes
  movemouse-smooth-diagonals yes
)

;; かなキー (scan 0x70)。kanata 標準の kana 名は KEY_HANGEUL に
;; 解決され 0x70 と一致しないため VK_DBE_KATAKANA (241) で上書きする。
(deflocalkeys-winiov2
  kana 241
)

(defsrc
  esc   caps  f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  grv   1     2     3     4     5     6     7     8     9     0     /     =     ¥     bspc
  tab   q     l     u     ,     .     f     w     r     y     p     [     ]     \
  f1    e     i     a     o     -     k     t     n     s     h     '     ret
  lsft  z     x     c     v     ;     g     d     m     j     b     ro    rsft
  lctl  lmet  lalt  mhnk        spc               hnk   kana  rctl
)

(defalias
  ;; Base mode
  to-qwerty (layer-switch qwerty)
  to-onishi (layer-switch onishi)
  ext (layer-while-held extra)

  ;; Space: tap = Space, hold = HUB.
  ;; require-prior-idle は使わない (押下直前の打鍵で hold が
  ;; キャンセルされ HUB が開かなくなるため)。
  spco (tap-hold-press 170 180 spc (layer-while-held hub-o))
  spcq (tap-hold-press 170 180 spc (layer-while-held hub-q))

  ;; Inside HUB: tap Shift selects IME, hold Shift opens the side layer.
  lso (tap-hold-press 150 170 grv (layer-while-held lhs-o) (require-prior-idle 0))
  rso (tap-hold-press 150 170 kana (layer-while-held rhs-o) (require-prior-idle 0))
  lsq (tap-hold-press 150 170 grv (layer-while-held lhs-q) (require-prior-idle 0))
  rsq (tap-hold-press 150 170 kana (layer-while-held rhs-q) (require-prior-idle 0))

  ;; Automation leader: while in a side layer, tap the opposite Shift.
  autoo (one-shot 1500 (layer-while-held auto-o))
  autoq (one-shot 1500 (layer-while-held auto-q))

  ;; Mouse mode is persistent until Space or Esc.
  mouse-o (layer-switch mouse-o)
  mouse-q (layer-switch mouse-q)
  back-o (layer-switch onishi)
  back-q (layer-switch qwerty)

  ;; HUB shortcuts (Windows).
  redo C-y
  app-prev A-S-tab
  app-next A-tab
  cmdfind C-f
  select-all C-a

  ;; Symbols: JIS 配列で意図した文字を出すキーへ変換したもの。
  lp S-8
  rp S-9
  lb ]
  rb \
  lc S-]
  rc S-\
  lt S-,
  gt S-.
  colon '
  semi ;
  dq S-2
  pipe S-¥
  minus -
  plus S-;
  eq S--
  slash /
  star S-'
  squote S-7
  bslash ¥
  under S-ro
  question S-/

  ;; Mouse movement and wheel.
  ml (movemouse-accel-left 1 700 1 12)
  mr (movemouse-accel-right 1 700 1 12)
  mu (movemouse-accel-up 1 700 1 12)
  md (movemouse-accel-down 1 700 1 12)
  mwl (mwheel-left 40 120)
  mwr (mwheel-right 40 120)
  mwu (mwheel-up 40 120)
  mwd (mwheel-down 40 120)
  slow (movemouse-speed 35)
  fast (movemouse-speed 250)

  ;; Hold to repeatedly click.
  auto-left (macro-repeat mltp 80)
  auto-right (macro-repeat mrtp 100)

  ;; Windows screenshots to clipboard.
  shot-select M-S-s
  shot-full prnt
  shot-window A-prnt

  ;; Dynamic macro slot 0.
  dm0 (dynamic-macro-record 0)
  dms dynamic-macro-record-stop
  dp0 (dynamic-macro-play 0)
)

;; ============================================================
;; Base: Onishi
;;   ChgKey の大西変換をそのまま通す。
;;   F1 -> QWERTY 切替, Caps 押し中は extra, Space 押し中は HUB。
;; ============================================================
(deflayer onishi
  esc   @to-qwerty  f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  grv   1     2     3     4     5     6     7     8     9     0     /     =     ¥     bspc
  tab   q     l     u     ,     .     f     w     r     y     p     [     ]     \
  @ext  e     i     a     o     -     k     t     n     s     h     '     ret
  lsft  z     x     c     v     ;     g     d     m     j     b     ro    rsft
  lctl  lmet  lalt  mhnk        @spco             hnk   kana  rctl
)

;; ============================================================
;; QWERTY: ChgKey で大西化された入力を QWERTY 文字へ逆変換。
;; 記号は JIS 配列で US 意図の文字が出るキー名へ変換済み。
;; ============================================================
(deflayer qwerty
  esc   @to-onishi  f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  grv   1     2     3     4     5     6     7     8     9     0     -     =     ¥     bspc
  tab   q     w     e     r     t     y     u     i     o     p     ]     \     ¥
  @ext  a     s     d     f     g     h     j     k     l     ;     @squote  ret
  lsft  z     x     c     v     b     n     m     ,     .     /     ro    rsft
  lctl  lmet  lalt  mhnk        @spcq             hnk   kana  rctl
)

;; ============================================================
;; Extra (Caps hold): 数字盤 + 矢印 + 記号 (現行 Windows 設定から移設)
;; ============================================================
(deflayer extra
  esc   @to-qwerty  f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  grv   1     2     3     4     5     6     7     8     9     0     /     =     ¥     bspc
  tab   q     7     8     9     ¥     prnt  home  end   del   p     ]     \     ¥
  @ext  e     4     5     6     0     lft   down  up    rght h     @squote  ret
  lsft  z     1     2     3     ;     ]     \     /     grv   @eq   ro    rsft
  lctl  lmet  lalt  esc         ent               bspc  kana  rctl
)

;; ============================================================
;; HUB (Space hold): ナビゲーション + クリップボード + レイヤー入口
;; ============================================================
(deflayer hub-o
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     @cmdfind  @app-prev  @app-next  S-ret  S-del  home  C-lft  C-home  C-rght  end  C-S-tab  C-tab  _
  _     esc   tab   bspc  ret   del   lft   down  up    rght  C-end  _     _
  @lso  C-z   C-x   C-c   C-v   @select-all  home  @mouse-o  pgup  end  pgdn  _     @rso
  _     _     _     _     _     _     _     _
)

(deflayer hub-q
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     @cmdfind  @app-prev  @app-next  S-ret  S-del  home  C-lft  C-home  C-rght  end  C-S-tab  C-tab  _
  _     esc   tab   bspc  ret   del   lft   down  up    rght  C-end  _     _
  @lsq  C-z   C-x   C-c   C-v   @select-all  home  @mouse-q  pgup  end  pgdn  _     @rsq
  _     _     _     _     _     _     _     _
)

;; ============================================================
;; Side layers: 左手シフト hold = 左シンボル + 右テンキー
;;              右手シフト hold = 右テンキー + 左シンボル
;; ============================================================
(deflayer lhs-o
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     XX    @lp   @rp   @lb   @rb   @minus  7     8     9     @plus  @squote  @bslash  @under
  _     XX    @lc   @rc   @lt   @gt   @eq   4     5     6     @slash  @question  _
  _     XX    @colon  @semi  @dq   @pipe  0     1     2     3     @star  _     @autoo
  _     _     _     _     _     _     _     _
)

(deflayer lhs-q
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     XX    @lp   @rp   @lb   @rb   @minus  7     8     9     @plus  @squote  @bslash  @under
  _     XX    @lc   @rc   @lt   @gt   @eq   4     5     6     @slash  @question  _
  _     XX    @colon  @semi  @dq   @pipe  0     1     2     3     @star  _     @autoq
  _     _     _     _     _     _     _     _
)

(deflayer rhs-o
  _     _     _     _     _     _     _     _     _     _     _     _     _
  @under  @question  _     _     _     _     _     _     _     _     _     _     _     _     _
  @squote  @minus  7     8     9     @plus  @lp   @rp   @lb   @rb   XX    _     _     _
  @bslash  @eq   4     5     6     @slash  @lc   @rc   @lt   @gt   XX    _     _
  @autoo  0     1     2     3     @star  @colon  @semi  @dq   @pipe  XX    _     _
  _     _     _     _     _     _     _     _
)

(deflayer rhs-q
  _     _     _     _     _     _     _     _     _     _     _     _     _
  @under  @question  _     _     _     _     _     _     _     _     _     _     _     _     _
  @squote  @minus  7     8     9     @plus  @lp   @rp   @lb   @rb   XX    _     _     _
  @bslash  @eq   4     5     6     @slash  @lc   @rc   @lt   @gt   XX    _     _
  @autoq  0     1     2     3     @star  @colon  @semi  @dq   @pipe  XX    _     _
  _     _     _     _     _     _     _     _
)

;; ============================================================
;; Automation (side layer 中に逆側 Shift をタップで one-shot)
;; ============================================================
(deflayer auto-o
  esc   XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX    f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12   XX    XX
  XX    @redo  @shot-window  XX    @dm0  XX    XX    XX    XX    XX    @dp0  XX    XX    XX
  XX    @auto-left  @shot-select  @auto-right  @shot-full  @dms  XX    XX    XX    lrld  XX    XX    XX
  XX    brdn  brup  vold  volu  mute  prev  @mouse-o  pp    next  XX    XX    XX
  XX    XX    XX    XX    XX    XX    XX    XX
)

(deflayer auto-q
  esc   XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX    f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12   XX    XX
  XX    @redo  @shot-window  XX    @dm0  XX    XX    XX    XX    XX    @dp0  XX    XX    XX
  XX    @auto-left  @shot-select  @auto-right  @shot-full  @dms  XX    XX    XX    lrld  XX    XX    XX
  XX    brdn  brup  vold  volu  mute  prev  @mouse-q  pp    next  XX    XX    XX
  XX    XX    XX    XX    XX    XX    XX    XX
)

;; ============================================================
;; Mouse (persistent until Space or Esc)
;; ============================================================
(deflayer mouse-o
  @back-o  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX    @mwu  @mu   @mwd  mmid  XX    XX    @mwu  mmid  @mwd  XX    XX    XX    XX
  XX    @ml   @md   @mr   mlft  mrgt  @ml   @md   @mu   @mr   mlft  mrgt  XX
  @slow  @mwl  @mwr  mmid  @auto-left  @auto-right  @mwl  @mwr  mmid  @auto-left  @auto-right  _     @slow
  XX    @fast  XX    XX    @back-o  XX    XX    XX
)

(deflayer mouse-q
  @back-q  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX    @mwu  @mu   @mwd  mmid  XX    XX    @mwu  mmid  @mwd  XX    XX    XX    XX
  XX    @ml   @md   @mr   mlft  mrgt  @ml   @md   @mu   @mr   mlft  mrgt  XX
  @slow  @mwl  @mwr  mmid  @auto-left  @auto-right  @mwl  @mwr  mmid  @auto-left  @auto-right  _     @slow
  XX    @fast  XX    XX    @back-q  XX    XX    XX
)
